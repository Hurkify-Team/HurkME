{
  "name": "@hurkme/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "echo \"No API lint task configured\"",
    "test": "npm run test:fast",
    "test:fast": "ts-node -r tsconfig-paths/register test/run-unit-tests.ts",
    "test:integration": "jest --runInBand --ci --no-cache --testPathPattern=admin.integration.spec.ts",
    "test:e2e": "ts-node -r tsconfig-paths/register test/core-flow.e2e.ts",
    "test:jest": "jest --runInBand --ci --no-cache",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "worker": "ts-node -r tsconfig-paths/register src/workers/main.ts",
    "worker:dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/workers/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@clerk/backend": "^1.27.4",
    "@hurkme/shared": "0.1.0",
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.20.0",
    "@sentry/node": "^8.34.0",
    "bullmq": "^5.10.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.1",
    "meilisearch": "^0.47.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.8.7",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
